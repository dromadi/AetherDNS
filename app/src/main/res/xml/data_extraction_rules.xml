<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: profil kustom ikut dicadangkan, status jeda tidak (hanya bermakna di perangkat & waktu asal). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="pause_state.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="pause_state.xml" />
    </device-transfer>
</data-extraction-rules>
