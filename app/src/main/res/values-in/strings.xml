    <string name="onboarding_welcome_title">Blokir iklan di level DNS</string>
    <string name="onboarding_welcome_desc">AetherDNS mengatur Private DNS (DNS-over-TLS) bawaan Android agar memakai resolver yang memfilter iklan dan pelacak.</string>
    <string name="onboarding_feature_battery_title">Tanpa beban baterai &amp; RAM</string>
    <string name="onboarding_feature_battery_desc">Android sendiri yang menjalankan DNS terenkripsi. Setelah diatur, AetherDNS boleh ditutup dan proteksi tetap aktif.</string>
    <string name="onboarding_feature_vpn_title">Tetap bisa memakai VPN</string>
    <string name="onboarding_feature_vpn_desc">AetherDNS tidak memakai slot VPN, jadi WireGuard, WARP, atau VPN lain tetap bisa dipakai.</string>
    <string name="onboarding_feature_scope_title">Yang dilakukan dan yang tidak</string>
    <string name="onboarding_feature_scope_desc">Memfilter domain iklan &amp; pelacak untuk seluruh HP. Tidak menyembunyikan IP dan tidak memblokir per aplikasi.</string>
    <string name="onboarding_permission_title">Berikan izin sekali saja</string>
    <string name="onboarding_permission_desc">Untuk mengubah setelan DNS sistem, AetherDNS butuh izin WRITE_SECURE_SETTINGS. Berikan sekali lewat Shizuku (tanpa PC) atau ADB. Anda juga bisa melewati langkah ini dan mengatur DNS secara manual.</string>
    <string name="onboarding_permission_granted">Izin sudah diberikan — siap digunakan.</string>
    <string name="onboarding_resolver_title">Pilih resolver</string>
    <string name="onboarding_resolver_desc">AdGuard DNS pilihan awal yang baik untuk memblokir iklan. Bisa diganti kapan saja, serta diuji kecepatan dan filternya di layar utama.</string>
    <string name="automation_title">Otomasi (Tasker / MacroDroid)</string>
    <string name="automation_desc">Izinkan aplikasi otomasi menyalakan/mematikan, menjeda, atau mengganti resolver.</string>
